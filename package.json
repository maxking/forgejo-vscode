{
  "name": "forgejo-vscode",
  "displayName": "Forgejo Integration",
  "description": "Browse Pull Requests, Issues, and Actions from Forgejo, Gitea, and Codeberg directly in VS Code",
  "version": "0.3.25",
  "publisher": "maxking",
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "forgejo_icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/maxking/forgejo-vscode.git"
  },
  "keywords": [
    "forgejo",
    "codeberg",
    "gitea",
    "git",
    "scm",
    "self-hosted",
    "issues",
    "pull-request",
    "code-review",
    "actions",
    "ci-cd"
  ],
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "icons": {
      "forgejo-logo": {
        "description": "Forgejo Logo",
        "default": {
          "fontPath": "./assets/font/forgejo-icons.woff2",
          "fontCharacter": "\\E900"
        }
      }
    },
    "authentication": [
      {
        "id": "forgejo",
        "label": "Forgejo"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgejoExplorer",
          "title": "Forgejo",
          "icon": "./assets/icons/forgejo-logo.svg"
        }
      ]
    },
    "views": {
      "forgejoExplorer": [
        {
          "id": "forgejoRemoteRepositories",
          "name": "Repositories"
        },
        {
          "id": "forgejoPullRequests",
          "name": "Pull Requests"
        },
        {
          "id": "forgejoIssues",
          "name": "Issues"
        },
        {
          "id": "forgejoActions",
          "name": "Actions"
        },
        {
          "id": "forgejoReleases",
          "name": "Releases"
        }
      ]
    },
    "webviews": {
      "viewContainers": [
        {
          "id": "forgejo.prDetail",
          "name": "PR Details"
        },
        {
          "id": "forgejo.issueDetail",
          "name": "Issue Details"
        },
        {
          "id": "forgejo.issueCreate",
          "name": "Create Issue"
        },
        {
          "id": "forgejo.actionDetail",
          "name": "Action Details"
        }
      ]
    },
    "commands": [
      {
        "command": "forgejo.publishToForgejo",
        "title": "Forgejo: Publish to Forgejo",
        "icon": "$(forgejo-logo)"
      },
      {
        "command": "forgejo.addInstance",
        "title": "Forgejo: Add Instance",
        "icon": "$(add)"
      },
      {
        "command": "forgejo.manageInstances",
        "title": "Forgejo: Manage Instances",
        "icon": "$(settings-gear)"
      },
      {
        "command": "forgejo.showDiagnostics",
        "title": "Forgejo: Show Diagnostics",
        "icon": "$(info)"
      },
      {
        "command": "forgejo.showPrivacyInfo",
        "title": "Forgejo: Show Privacy & Data Info",
        "icon": "$(shield)"
      },
      {
        "command": "forgejo.validateWorkflows",
        "title": "Forgejo: Validate Workflow Files",
        "icon": "$(checklist)"
      },
      {
        "command": "forgejo.showOutput",
        "title": "Forgejo: Show Output Channel",
        "icon": "$(output)"
      },
      {
        "command": "forgejo.refreshPullRequests",
        "title": "Forgejo: Refresh Pull Requests",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejo.refreshRepositoryPullRequests",
        "title": "Refresh Pull Requests",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejo.searchPullRequests",
        "title": "Forgejo: Search Pull Requests",
        "icon": "$(search)"
      },
      {
        "command": "forgejo.refreshIssues",
        "title": "Forgejo: Refresh Issues",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejo.loadMorePullRequestFiles",
        "title": "Forgejo: Load More Pull Request Files",
        "icon": "$(more)"
      },
      {
        "command": "forgejo.browseRemoteRepository",
        "title": "Forgejo: Browse Remote Repository",
        "icon": "$(search)"
      },
      {
        "command": "forgejo.refreshRemoteRepositories",
        "title": "Forgejo: Refresh Remote Repositories",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejo.selectRemoteRepositoryBranch",
        "title": "Select Branch",
        "icon": "$(git-branch)"
      },
      {
        "command": "forgejo.openRemoteFile",
        "title": "Open Remote File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "forgejo.searchIssues",
        "title": "Forgejo: Search Issues",
        "icon": "$(search)"
      },
      {
        "command": "forgejo.configureInstanceUrl",
        "title": "Forgejo: Configure Instance URL (Legacy)"
      },
      {
        "command": "forgejo.setAuthToken",
        "title": "Forgejo: Set Authentication Token (Legacy)"
      },
      {
        "command": "forgejo.openPrInBrowser",
        "title": "Forgejo: Open PR in Browser"
      },
      {
        "command": "forgejo.openIssueInBrowser",
        "title": "Forgejo: Open Issue in Browser"
      },
      {
        "command": "forgejo.showPrFileDiff",
        "title": "Show Diff"
      },
      {
        "command": "forgejo.openPrInBrowserFromContext",
        "title": "Open PR in Browser"
      },
      {
        "command": "forgejo.openPrFileInBrowser",
        "title": "Open File in Browser"
      },
      {
        "command": "forgejo.showPrDetails",
        "title": "View PR Details",
        "icon": "$(info)"
      },
      {
        "command": "forgejo.mergePr",
        "title": "Merge PR...",
        "icon": "$(git-merge)"
      },
      {
        "command": "forgejo.closePr",
        "title": "Close PR",
        "icon": "$(circle-slash)"
      },
      {
        "command": "forgejo.showIssueDetails",
        "title": "View Issue Details",
        "icon": "$(info)"
      },
      {
        "command": "forgejo.startWorkOnIssue",
        "title": "Start Work on Issue",
        "icon": "$(git-branch)"
      },
      {
        "command": "forgejo.openIssueInBrowserFromContext",
        "title": "Open Issue in Browser"
      },
      {
        "command": "forgejo.createIssue",
        "title": "Forgejo: Create Issue",
        "icon": "$(add)"
      },
      {
        "command": "forgejo.createIssueForRepository",
        "title": "Create Issue",
        "icon": "$(add)"
      },
      {
        "command": "forgejo.createIssueFromTodo",
        "title": "Forgejo: Create Issue from TODO",
        "icon": "$(add)"
      },
      {
        "command": "forgejo.refreshActions",
        "title": "Forgejo: Refresh Actions",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejo.loadMoreActions",
        "title": "Load More Actions",
        "icon": "$(more)"
      },
      {
        "command": "forgejo.openActionInBrowser",
        "title": "Open Action in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "forgejo.rerunAction",
        "title": "Re-run Workflow",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "forgejo.viewActionLogs",
        "title": "View Logs",
        "icon": "$(output)"
      },
      {
        "command": "forgejo.viewStepLogs",
        "title": "View Step Logs",
        "icon": "$(output)"
      },
      {
        "command": "forgejo.openWorkflowFile",
        "title": "Open Workflow File",
        "icon": "$(file-code)"
      },
      {
        "command": "forgejo.showActionDetails",
        "title": "View Action Details",
        "icon": "$(info)"
      },
      {
        "command": "forgejo.selectRemote",
        "title": "Forgejo: Select Git Remote"
      },
      {
        "command": "forgejo.createPullRequest",
        "title": "Forgejo: Create Pull Request",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "forgejo.createPullRequestForRepository",
        "title": "Create Pull Request",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "forgejo.submitInlineComment",
        "title": "Submit Comment"
      },
      {
        "command": "forgejo.refreshReleases",
        "title": "Forgejo: Refresh Releases",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejo.loadMoreReleases",
        "title": "Forgejo: Load More Releases",
        "icon": "$(more)"
      },
      {
        "command": "forgejo.createRelease",
        "title": "Forgejo: Create Release",
        "icon": "$(add)"
      },
      {
        "command": "forgejo.openReleaseInBrowser",
        "title": "Open Release in Browser",
        "icon": "$(link-external)"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          ".forgejo/workflows/*.{yml,yaml}",
          ".gitea/workflows/*.{yml,yaml}"
        ],
        "url": "./out/diagnostics/schemas/forgejo-workflow.schema.json"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "forgejo.browseRemoteRepository",
          "when": "view == forgejoRemoteRepositories",
          "group": "navigation@0"
        },
        {
          "command": "forgejo.refreshRemoteRepositories",
          "when": "view == forgejoRemoteRepositories",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.manageInstances",
          "when": "view == forgejoRemoteRepositories",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.createPullRequest",
          "when": "view == forgejoPullRequests && !forgejo.multipleRepositories",
          "group": "navigation@0"
        },
        {
          "command": "forgejo.refreshPullRequests",
          "when": "view == forgejoPullRequests",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.searchPullRequests",
          "when": "view == forgejoPullRequests",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.manageInstances",
          "when": "view == forgejoPullRequests",
          "group": "navigation@3"
        },
        {
          "command": "forgejo.createIssue",
          "when": "view == forgejoIssues && !forgejo.multipleRepositories",
          "group": "navigation@0"
        },
        {
          "command": "forgejo.refreshIssues",
          "when": "view == forgejoIssues",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.searchIssues",
          "when": "view == forgejoIssues",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.manageInstances",
          "when": "view == forgejoIssues",
          "group": "navigation@3"
        },
        {
          "command": "forgejo.refreshActions",
          "when": "view == forgejoActions",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.manageInstances",
          "when": "view == forgejoActions",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.createRelease",
          "when": "view == forgejoReleases",
          "group": "navigation@0"
        },
        {
          "command": "forgejo.refreshReleases",
          "when": "view == forgejoReleases",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.manageInstances",
          "when": "view == forgejoReleases",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "forgejo.selectRemoteRepositoryBranch",
          "when": "false"
        },
        {
          "command": "forgejo.openRemoteFile",
          "when": "false"
        },
        {
          "command": "forgejo.createIssueFromTodo",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "forgejo.browseRemoteRepository",
          "when": "viewItem == forgejoRemoteInstance",
          "group": "inline@0"
        },
        {
          "command": "forgejo.selectRemoteRepositoryBranch",
          "when": "viewItem == forgejoRemoteRepository",
          "group": "inline@0"
        },
        {
          "command": "forgejo.openRemoteFile",
          "when": "viewItem == forgejoRemoteFile",
          "group": "navigation@0"
        },
        {
          "command": "forgejo.createPullRequestForRepository",
          "when": "viewItem == forgejoPrRepository",
          "group": "inline@0"
        },
        {
          "command": "forgejo.refreshRepositoryPullRequests",
          "when": "viewItem == forgejoPrRepository",
          "group": "inline@1"
        },
        {
          "command": "forgejo.showPrDetails",
          "when": "viewItem == prOverview",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.openPrInBrowserFromContext",
          "when": "viewItem == pullRequest",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.mergePr",
          "when": "viewItem == pullRequest",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.closePr",
          "when": "viewItem == pullRequest",
          "group": "navigation@3"
        },
        {
          "command": "forgejo.openPrFileInBrowser",
          "when": "viewItem == prFile",
          "group": "navigation"
        },
        {
          "command": "forgejo.createIssueForRepository",
          "when": "viewItem == forgejoIssueRepository",
          "group": "inline@0"
        },
        {
          "command": "forgejo.startWorkOnIssue",
          "when": "viewItem == issue",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.showIssueDetails",
          "when": "viewItem == issue",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.openIssueInBrowserFromContext",
          "when": "viewItem == issue",
          "group": "navigation@3"
        },
        {
          "command": "forgejo.showActionDetails",
          "when": "viewItem == workflowRun || viewItem == workflowRunFailed || viewItem == workflowJob || viewItem == workflowJobFailed",
          "group": "navigation@0"
        },
        {
          "command": "forgejo.openActionInBrowser",
          "when": "viewItem == workflowRun || viewItem == workflowRunFailed || viewItem == workflowJob || viewItem == workflowJobFailed || viewItem == workflowStep",
          "group": "navigation@1"
        },
        {
          "command": "forgejo.rerunAction",
          "when": "viewItem == workflowRun || viewItem == workflowRunFailed || viewItem == workflowJob || viewItem == workflowJobFailed",
          "group": "navigation@2"
        },
        {
          "command": "forgejo.viewActionLogs",
          "when": "viewItem == workflowRun || viewItem == workflowRunFailed || viewItem == workflowJob || viewItem == workflowJobFailed || viewItem == workflowStep",
          "group": "navigation@3"
        },
        {
          "command": "forgejo.openWorkflowFile",
          "when": "viewItem == workflowRun || viewItem == workflowRunFailed || viewItem == workflowJob || viewItem == workflowJobFailed",
          "group": "navigation@4"
        },
        {
          "command": "forgejo.createRelease",
          "when": "viewItem == releaseRepository || viewItem == releaseGroup",
          "group": "navigation@0"
        },
        {
          "command": "forgejo.openReleaseInBrowser",
          "when": "viewItem == release || viewItem == releaseDraft || viewItem == releasePrerelease",
          "group": "navigation@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "forgejo.submitInlineComment",
          "group": "inline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "scm",
        "contents": "You can push the current folder to a new Forgejo repository.\n[$(forgejo-logo) Publish to Forgejo](command:forgejo.publishToForgejo)",
        "when": "config.git.enabled && git.state == initialized && workbenchState == folder"
      },
      {
        "view": "scm",
        "contents": "You can push any of the current folders to a new Forgejo repository.\n[$(forgejo-logo) Publish to Forgejo](command:forgejo.publishToForgejo)",
        "when": "config.git.enabled && git.state == initialized && workbenchState == workspace"
      },
      {
        "view": "forgejoRemoteRepositories",
        "contents": "No Forgejo instance configured.\n[Add Forgejo Instance](command:forgejo.addInstance)",
        "when": "forgejo.noInstanceConfigured"
      },
      {
        "view": "forgejoPullRequests",
        "contents": "No Forgejo instance configured.\n[Add Forgejo Instance](command:forgejo.addInstance)\nAuto-detection from git remotes is also supported.",
        "when": "forgejo.noInstanceConfigured"
      },
      {
        "view": "forgejoIssues",
        "contents": "No Forgejo instance configured.\n[Add Forgejo Instance](command:forgejo.addInstance)\nAuto-detection from git remotes is also supported.",
        "when": "forgejo.noInstanceConfigured"
      },
      {
        "view": "forgejoActions",
        "contents": "No Forgejo instance configured.\n[Add Forgejo Instance](command:forgejo.addInstance)\nAuto-detection from git remotes is also supported.",
        "when": "forgejo.noInstanceConfigured"
      }
    ],
    "configuration": {
      "title": "Forgejo",
      "properties": {
        "forgejo.instances": {
          "type": "array",
          "default": [],
          "description": "Configured Forgejo instances",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "instanceUrl": {
                "type": "string"
              },
              "sshHost": {
                "type": "string",
                "description": "Optional hostname used by SSH git remotes for this instance, when it differs from the web/API host (instanceUrl). Used for matching SSH git remotes to this instance and for rewriting SSH clone URLs so they point at the reachable SSH service host."
              },
              "sshPort": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "Optional SSH port for clone URLs from this instance. Independent of sshHost: both may be set simultaneously. Injected only when the clone URL does not already specify a port."
              },
              "token": {
                "type": "string",
                "deprecationMessage": "Tokens are now stored securely in the OS keychain via VS Code SecretStorage. Any token here will be migrated automatically."
              },
              "isDefault": {
                "type": "boolean"
              },
              "lastConnectionTest": {
                "type": "object"
              }
            }
          }
        },
        "forgejo.instanceUrl": {
          "type": "string",
          "default": "",
          "description": "[DEPRECATED] Use forgejo.instances instead. Forgejo instance URL (e.g., https://codeberg.org)",
          "deprecationMessage": "Use 'forgejo.instances' for multi-instance support. This setting is kept for backward compatibility."
        },
        "forgejo.token": {
          "type": "string",
          "default": "",
          "description": "[DEPRECATED] Tokens are now stored securely via VS Code SecretStorage (OS keychain). Any token here will be migrated automatically on next activation.",
          "deprecationMessage": "Tokens are now stored securely via VS Code SecretStorage. This setting is kept only for backward compatibility migration."
        },
        "forgejo.autoDetectFromRemote": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect Forgejo instance from git remote"
        },
        "forgejo.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging in the Forgejo output channel"
        },
        "forgejo.showFileStatusNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when opening files that were added or deleted in a pull request"
        },
        "forgejo.preferredRemote": {
          "type": "string",
          "default": "",
          "description": "Preferred git remote name to use for Forgejo detection (default: auto-detect, falls back to origin)"
        },
        "forgejo.startWorkOnIssueBaseRef": {
          "type": "string",
          "default": "origin/master",
          "description": "Git ref to create Start Work on Issue branches from"
        }
      }
    }
  },
  "scripts": {
    "postinstall": "patch-package",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && tsc -p ./tsconfig.test.json && cp src/webview/prDetail/index.js src/webview/prDetail/styles.css out/webview/prDetail/ && mkdir -p out/webview/issueDetail && cp src/webview/issueDetail/index.js src/webview/issueDetail/styles.css out/webview/issueDetail/ && mkdir -p out/webview/issueCreate && cp src/webview/issueCreate/index.js src/webview/issueCreate/styles.css out/webview/issueCreate/ && mkdir -p out/webview/actionDetail && cp src/webview/actionDetail/index.js src/webview/actionDetail/styles.css out/webview/actionDetail/",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --baseContentUrl https://codeberg.org/maxking/forgejo-vscode/raw/branch/master --baseImagesUrl https://codeberg.org/maxking/forgejo-vscode/raw/branch/master",
    "publish-vscode": "vsce publish --baseContentUrl https://codeberg.org/maxking/forgejo-vscode/raw/branch/master --baseImagesUrl https://codeberg.org/maxking/forgejo-vscode/raw/branch/master",
    "lint": "eslint src --ext ts",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "pretest:integration": "npm run compile",
    "test:integration": "vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:vscode": "playwright test --config playwright.vscode.config.ts",
    "test:e2e:vscode:headed": "playwright test --config playwright.vscode.config.ts --headed",
    "test:e2e:vscode:debug": "playwright test --config playwright.vscode.config.ts --debug",
    "test:ci": "npm run lint && npm run test:unit:coverage && npm run test:integration",
    "test:live": "jest --testPathPattern='forgejoClient\\.live\\.test'",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:live:local": "bash scripts/run-e2e-local.sh",
    "update:workflow-schema": "node scripts/update-workflow-schema.mjs"
  },
  "devDependencies": {
    "@mshanemc/vscode-test-playwright": "^0.0.1-beta14",
    "@playwright/test": "~1.52.0",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "patch-package": "^8.0.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "forgejo-ts": "^0.4.1",
    "yaml": "^2.8.2"
  }
}
